PORT=3000
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/red-social?retryWrites=true&w=majority
# Orígenes permitidos para CORS (la URL del front), separados por coma
CORS_ORIGIN=http://localhost:4200
# Clave para firmar los tokens JWT (Sprint 3). Obligatoria: una frase larga y secreta,
# distinta en cada entorno. Por ejemplo, la que da: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-por-una-clave-larga-y-secreta
# Opcional: URL pública del backend para armar la URL de las imágenes.
# En local se usa http://localhost:3000 y en Render la detecta sola.
# PUBLIC_URL=
# Opcional: guardar las imágenes en Cloudinary en lugar de la carpeta uploads/.
# Se copia del panel de Cloudinary ("API environment variable").
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
