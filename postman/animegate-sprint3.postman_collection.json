        {
          "name": "Editar sin token (401)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/publicaciones/{{idPub}}/comentarios/{{idComentarioBeto}}",
            "description": "Sin header Authorization → 401.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensaje\": \"Hola\"\n}",
