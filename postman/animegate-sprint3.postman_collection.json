        },
        {
          "name": "Listar comentarios (200)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/publicaciones/{{idPub}}/comentarios",
            "description": "Los más recientes primero: el de Ana arriba.",
            "header": []
