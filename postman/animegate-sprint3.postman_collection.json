        },
        {
          "name": "Ana comenta (201)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/publicaciones/{{idPub}}/comentarios",
            "description": "Segundo comentario (el más nuevo).",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensaje\": \"Yo el anime, por la música\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
