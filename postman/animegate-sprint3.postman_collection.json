    {
      "name": "1 · Autenticación JWT",
      "description": "El token vence a los 15 minutos y lleva el id, el correo, el nombre de usuario y el rol.",
      "item": [
        {
          "name": "Login devuelve el token (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "description": "Login con usuario y contraseña → { usuario, token }. Se revisa la payload del token.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador\": \"{{usuarioAna}}\",\n  \"password\": \"Clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const payload = (t) => JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "const r = pm.response.json(); const p = payload(r.token);",
                  "pm.test('Sin contraseña', () => pm.expect(r.usuario).to.not.have.property('password'));",
                  "pm.test('Payload: id, correo, usuario y rol', () => { pm.expect(p.sub).to.eql(pm.collectionVariables.get('idAna')); pm.expect(p.nombreUsuario).to.eql(pm.collectionVariables.get('usuarioAna')); pm.expect(p.correo).to.include('@test.com'); pm.expect(p.perfil).to.eql('usuario'); });",
                  "pm.test('Vence a los 15 minutos', () => pm.expect(p.exp - p.iat).to.eql(900));",
                  "pm.collectionVariables.set('tokenAna', r.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Autorizar con token válido (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/autorizar",
            "description": "Authorization: Bearer <token> → 200 con los datos del usuario.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Es Ana, sin contraseña', () => { const u = pm.response.json(); pm.expect(u._id).to.eql(pm.collectionVariables.get('idAna')); pm.expect(u).to.not.have.property('password'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Autorizar sin token (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/autorizar",
            "description": "Sin header Authorization → 401.",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('El mensaje explica el error', () => { const m = pm.response.json().message; pm.expect([].concat(m).join(' | ')).to.include(\"iniciar sesi\\u00f3n\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Autorizar con token inválido (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/autorizar",
            "description": "Un texto que no es un token → 401.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer esto.no.sirve"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('El mensaje explica el error', () => { const m = pm.response.json().message; pm.expect([].concat(m).join(' | ')).to.include(\"venci\\u00f3 o no es v\\u00e1lida\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Token manipulado: rol administrador (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/autorizar",
            "description": "El pre-request toma el token de Ana y cambia su rol a administrador sin volver a firmarlo. Como la firma ya no coincide, el back lo rechaza: el rol no se puede inventar.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenManipulado}}"
              }
            ]
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const [cab, cuerpo, firma] = pm.collectionVariables.get('tokenAna').split('.');",
                  "const p = JSON.parse(atob(cuerpo.replace(/-/g, '+').replace(/_/g, '/')));",
                  "p.perfil = 'administrador';",
                  "const nuevo = btoa(JSON.stringify(p)).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
                  "pm.collectionVariables.set('tokenManipulado', [cab, nuevo, firma].join('.'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refrescar el token (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refrescar",
            "description": "Con un token válido → { token } nuevo con la misma payload y otros 15 minutos. Esperá un segundo después del login para que el vencimiento cambie.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const payload = (t) => JSON.parse(atob(t.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
                  "const viejo = pm.collectionVariables.get('tokenAna');",
                  "const nuevo = pm.response.json().token;",
                  "pm.test('Misma payload', () => { const a = payload(viejo), b = payload(nuevo); pm.expect([b.sub, b.correo, b.nombreUsuario, b.perfil]).to.eql([a.sub, a.correo, a.nombreUsuario, a.perfil]); });",
                  "pm.test('Otros 15 minutos', () => { const b = payload(nuevo); pm.expect(b.exp - b.iat).to.eql(900); pm.expect(b.exp).to.be.at.least(payload(viejo).exp); });",
                  "pm.collectionVariables.set('tokenAna', nuevo);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refrescar sin token (401)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refrescar",
            "description": "Sin header Authorization → 401.",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "El token refrescado sirve (200)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/autorizar",
            "description": "Se autoriza con el token nuevo.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAna}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
