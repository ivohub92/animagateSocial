                  "pm.test('Más recientes primero', () => { const f = r.items.map((c) => Date.parse(c.createdAt)); for (let i = 1; i < f.length; i++) pm.expect(f[i - 1]).to.be.at.least(f[i]); pm.expect(r.items[0].usuario._id).to.eql(pm.collectionVariables.get('idAna')); });"
