          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.test('Con autor, fecha y sin editar', () => { pm.expect(c.usuario._id).to.eql(pm.collectionVariables.get('idBeto')); pm.expect(Date.parse(c.createdAt)).to.be.a('number'); pm.expect(c.modificado).to.eql(false); });",
                  "pm.collectionVariables.set('idComentarioBeto', c._id);"
                ]
              }
